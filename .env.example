# Copy to .env and fill in. .env is gitignored; config.ini is not, so the key
# must never go there — Config.load refuses to start if it finds one.
#
# In CI this is a repository/project secret injected as an environment
# variable, and .env does not exist. A real environment variable always wins
# over .env, so the same code path works in both places.
#
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
